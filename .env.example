# Copy to .env. Default demo mode does not send requests to models or search APIs.
RESEARCH_MODE=demo
RESEARCH_DATA_DIR=./data
# Redis is optional for offline demo, required for the complete online stack.
# Project Redis uses 6380. For the WSL runtime, include its generated local password.
RESEARCH_REDIS_URL=redis://127.0.0.1:6380/0
# Any compatible chat-completions provider; no automatic use of machine keys.
RESEARCH_MODEL_NAME=
RESEARCH_MODEL_BASE_URL=
RESEARCH_MODEL_API_KEY=
# tavily or searxng. For Tavily the endpoint can be left at its adapter default.
RESEARCH_SEARCH_PROVIDER=tavily
RESEARCH_SEARCH_BASE_URL=
RESEARCH_SEARCH_API_KEY=
# Compatible embeddings endpoint/model. Used by live knowledge retrieval/cache.
RESEARCH_EMBEDDING_MODEL=
RESEARCH_EMBEDDING_BASE_URL=
RESEARCH_EMBEDDING_API_KEY=
RESEARCH_EMBEDDING_DIMENSIONS=1536
RESEARCH_SEMANTIC_THRESHOLD=0.92
RESEARCH_CACHE_TTL_SECONDS=3600
RESEARCH_MAX_TASKS=2
RESEARCH_MAX_TOOL_CALLS=36
RESEARCH_MAX_MODEL_CALLS=18
RESEARCH_TASK_TIMEOUT_SECONDS=300
RESEARCH_TOOL_TIMEOUT_SECONDS=25

